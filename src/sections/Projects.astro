<section id="services" class="reveal scroll-mt-24 px-6 md:px-[8vw] py-28">
    <h2 class="font-extrabold text-4xl md:text-6xl max-w-2xl">
        Eat at the cart, or we bring the cart to you.
    </h2>
    <div class="mt-12 grid md:grid-cols-3 gap-6">
        <article class="glass-card p-8">
            <h3 class="font-semibold text-2xl">Night cart</h3>
            <p class="mt-3">
                Walk up, order, and eat within ten minutes. Open every evening, rain or shine.
            </p>
            <p class="mt-6 opacity-80">5 pm to midnight</p>
        </article>
        <article class="glass-card p-8">
            <h3 class="font-semibold text-2xl">Event catering</h3>
            <p class="mt-3">
                We set up a grill at your party, market, or office event and cook for 30 to 100
                people.
            </p>
            <p class="mt-6 opacity-80">From ₱800 per guest</p>
        </article>
        <article class="glass-card p-8">
            <h3 class="font-semibold text-2xl">Late delivery</h3>
            <p class="mt-3">
                Skewer boxes and noodle bowls delivered hot within three kilometers of the cart.
            </p>
            <p class="mt-6 opacity-80">₱30 flat fee</p>
        </article>
    </div>
</section>

